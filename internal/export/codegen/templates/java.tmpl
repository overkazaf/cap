import okhttp3.MediaType;
import okhttp3.OkHttpClient;
import okhttp3.Request;
import okhttp3.RequestBody;
import okhttp3.Response;

public class Main {
    public static void main(String[] args) throws Exception {
        OkHttpClient client = new OkHttpClient();
{{- if hasBody .}}
        MediaType mediaType = MediaType.parse({{printf "%q" .ReqBodyType}});
        RequestBody body = RequestBody.create(mediaType, {{printf "%q" (printf "%s" .ReqBody)}});
{{- end}}

        Request request = new Request.Builder()
            .url({{printf "%q" .URL}})
{{- if hasBody .}}
            .method({{printf "%q" .Method}}, body)
{{- else}}
            .method({{printf "%q" .Method}}, null)
{{- end}}
{{- range sortedHeaders .ReqHeaders}}
            .addHeader({{printf "%q" .K}}, {{printf "%q" .V}})
{{- end}}
            .build();

        Response response = client.newCall(request).execute();
        System.out.println(response.code());
        System.out.println(response.body().string());
    }
}
